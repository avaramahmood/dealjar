# Copy to .env.local for local development (git-ignored). On Render, type these into the dashboard instead.
# Nothing here is ever committed, and secrets are never pasted into chat or tickets.

# --- Required in production -------------------------------------------------
# Signs login tokens and salts the referral device hash. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable: changing it signs everyone out.
SESSION_SECRET=

# Postgres connection string. Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler"
# (port 6543). If unset, an embedded Postgres (PGlite) is used and stored in ./.data/pglite: local development only.
DATABASE_URL=

# A Nimiq JSON-RPC node, used to verify payments by hash and to find them by memo. Open servers are for testing only.
# https://nimiq.dev/rpc/open-servers
NIMIQ_RPC_URL=

# Comma-separated Nimiq addresses that become admins the first time they sign in (public, not secret).
ADMIN_ADDRESSES=

# The Nimiq address that receives sponsors' pot deposits (and the referral pot top-ups). You hold its key: you also pay
# cash-outs from it. Public, not secret.
POOL_ADDRESS=

# Protects POST /api/cron/<job> (for an external scheduler). 16+ random characters. Optional if you only use the Render cron jobs.
CRON_SECRET=

# --- Image storage (Supabase Storage's S3 endpoint, or any S3-compatible bucket) ----------
# Supabase: Storage -> create a bucket (it can stay private: the server serves images itself) ->
# Project Settings -> Storage -> S3 Connection for the endpoint, region and access keys.
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local disk fallback when S3_BUCKET is unset (development).
MEDIA_DIR=./.data/media

# --- Prices (optional) -------------------------------------------------------
# A CoinGecko demo API key raises the rate limit. The price job works without one.
PRICE_API_KEY=
# Used until the price job has run, and as the safety net if the API is down.
NIM_USD_FALLBACK=0.0025
EUR_USD_FALLBACK=1.09
XAU_USD_FALLBACK=2650

# --- Product knobs -------------------------------------------------------------
# What each side of a referral earns, in micro-dollars (1,000,000 = $1).
REFERRAL_REWARD_MICRO=2000000
# The most one payment may be, in NIM. A safety net against typos and hostile deals.
DEALJAR_MAX_NIM=50000
# Minutes a reserved reward is held before it goes back to the pot.
RESERVATION_MINUTES=60
# 1 = new sponsors go live without waiting for an admin. Leave 0 unless you want that.
DEALJAR_AUTO_APPROVE=0
# 0 = no fictional demo sponsors (use this in production). 1 = seed them on an empty database.
DEALJAR_SEED=1

# --- Local development / tests ONLY ------------------------------------------------
# Persona login (member / studio / admin) without a wallet.
DEALJAR_DEMO=0
# Skips the on-chain check for "demo-" transaction hashes. NEVER enable with real money (the server refuses to start in production).
DEALJAR_DEMO_PAYMENTS=0
# Turns off abuse rate limits for tests (the server refuses to start in production with this on).
DEALJAR_NO_RATE_LIMIT=0
API_PORT=8788
